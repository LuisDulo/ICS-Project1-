<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Hire a Designer - ArtHub</title>
  <link rel="stylesheet" href="/Designers.css" />
</head>
<body>
  <header class="navbar">
    <div class="logo">🎨 ArtHub</div>
    <nav>
      <a href="/home">Home</a>
      <a href="/canvas">Canvas Editor</a>
      <a href="/marketplace">Marketplace</a>
      <a href="#" class="active">Hire a Designer</a>
      <a href="/profile">User Profiles</a>
    </nav>
    <div class="user-icon">👤</div>
  </header>

  <section class="hero-section">
    <div class="hero-content">
      <h1>Find Your Perfect Creative Partner</h1>
      <p>Connect with top artists and designers for custom projects, branding, illustration, and more.</p>
      <a href="/postJob"><button class="btn">Post Your Job</button></a>
    </div>
    <div class="hero-image">
      <img src="/collaborate.jpg" alt="Team discussing project"/>
    </div>
  </section>

  <section class="filters-section">
    <aside class="filters">
      <h3>Filters</h3>
      <label><input type="checkbox" /> Logo Design</label>
      <label><input type="checkbox" /> Illustration</label>
      <label><input type="checkbox" /> Branding</label>
      <label><input type="checkbox" /> Concept Art</label>
      <button class="btn small">Apply Filters</button>
    </aside>

    <div class="artists-grid">
      <% artists.forEach(artist => { %>
        <div class="artist-card">
          <img src="<%= artist.image %>" alt="Artist">
          <h4><%= artist.name %></h4>
          <p><%= artist.specialty %></p>
          <p>⭐ <%= artist.rating %> (<%= artist.reviews %>)</p>
          <p>Ksh<%= artist.rate %>/hr</p>
          <button class="btn small"><a href="/profile/<%= artist.id %>">View Profile</a></button>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="featured">
    <h2>Featured Artists</h2>
    <div class="artists-grid">
      <% featured.forEach(artist => { %>
        <div class="artist-card">
          <img src="<%= artist.image %>" alt="Artist">
          <h4><%= artist.name %></h4>
          <p><%= artist.specialty %></p>
          <p>⭐ <%= artist.rating %> (<%= artist.reviews %>)</p>
          <p>Ksh<%= artist.rate %>/hr</p>
          <button class="btn small"><a href="/profile/<%= artist.id %>">View Profile</a></button>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="how-it-works">
    <h2>How It Works</h2>
    <div class="steps">
      <div class="step"><h3>1</h3><p>Define Your Project</p></div>
      <div class="step"><h3>2</h3><p>Browse & Connect</p></div>
      <div class="step"><h3>3</h3><p>Collaborate & Create</p></div>
    </div>
  </section>

  <section class="testimonials">
    <h2>Success Stories</h2>
    <div class="stories">
      <div class="story">
        <p>"I found an amazing illustrator in minutes! Seamless experience." <br> <strong>- Sarah</strong></p>
      </div>
      <div class="story">
        <p>"Our branding looks stunning. Thank you ArtHub!" <br> <strong>- Michael</strong></p>
      </div>
    </div>
  </section>

  <footer>
    <div class="footer-content">
      <p>© 2025 ArtHub</p>
      <div class="newsletter">
        <input type="email" placeholder="Your email address">
        <button class="btn small">Subscribe</button>
      </div>
    </div>
  </footer>
</body>
</html>
