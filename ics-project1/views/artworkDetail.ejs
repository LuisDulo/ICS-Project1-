<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= artwork.title %> | Artify</title>
  <link rel="stylesheet" href="/artworkDetail.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>
  <div class="artwork-header">
    <img src="<%= artwork.imageUrl || '/default-art.png' %>" alt="<%= artwork.title %>">
    <div class="info">
      <h1><%= artwork.title %></h1>
      <p class="price">$<%= artwork.price %></p>
      <p class="desc"><%= artwork.description %></p>
      <p class="creator">By <strong><%= artwork.artist || 'Unknown' %></strong></p>
      <button class="buy-btn">Purchase Artwork</button>
      <button class="report-btn">Report</button>
    </div>
  </div>

  <section class="details">
    <h2>About the Artwork</h2>
    <p><%= artwork.longDescription || 'No additional information provided.' %></p>
  </section>

  <section class="ratings">
    <h2>Ratings</h2>
    <div class="stars">
      <% const stars = Math.round(artwork.rating || 0); %>
      <% for(let i = 0; i < 5; i++) { %>
        <i class="fa-star <%= i < stars ? 'fas' : 'far' %>"></i>
      <% } %>
      <span><%= artwork.rating || 0 %>/5</span>
    </div>
  </section>

  <section class="comments">
    <h2>Comments</h2>
    <% if (artwork.comments && artwork.comments.length) { %>
      <ul>
        <% artwork.comments.forEach(c => { %>
          <li><strong><%= c.user %>:</strong> <%= c.text %></li>
        <% }) %>
      </ul>
    <% } else { %>
      <p>No comments yet.</p>
    <% } %>
  </section>
</body>
</html>
