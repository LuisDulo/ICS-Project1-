<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>ArtHub - Home</title>
  <link rel="stylesheet" href="/home.css" />
  <link rel="stylesheet" href="/marketplace.css" />
</head>
<body>

  <header class="navbar">
    <div class="logo">🎨 ArtHub</div>
    <nav>
      <a class="active" href="/home">Home</a>
      <a href="/Canvas.html">Canvas Editor</a>
      <a href="/marketplace">Marketplace</a>
      <a href="/designers">Hire a Designer</a>
      <a href="/user-profile">My Profile</a>
    </nav>
    <a href="/settings" class="user-icon" title="User Settings">👤</a>
  </header>

  <!-- Hero Banner -->
  <section class="hero-banner">
    <div class="container">
      <h1>Discover Your Next Masterpiece</h1>
      <p>Explore ArtHub’s curated collection of unique digital art and merchandise from talented artists worldwide.</p>
      <button class="btn"><a href="/marketplace">Explore Marketplace</a></button>
    </div>
  </section>

  <!-- Featured Artworks -->
  <section class="section">
    <div class="container">
      <h2 class="featured-title">Featured Artworks</h2>
      <div class="grid">
        <% artworks.forEach(art => { %>
          <div class="card">
            <img src="<%= art.image %>" alt="<%= art.title %>" />
            <p class="art-title"><%= art.title %></p>
            <p class="artist">By <%= art.artist %></p>
            <p class="price">ksh<%= art.price %></p>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Popular Artists -->
  <section class="section" style="background-color: var(--bg-white);">
    <div class="container">
      <h2 class="featured-title">Popular Artists</h2>
      <div class="avatar-grid">
        <% popularArtists.forEach(artist => { %>
          <div class="avatar">
            <img src="<%= artist.image %>" alt="<%= artist.name %>" />
            <p><%= artist.name %></p>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Discover Categories -->
  <section class="section">
    <div class="container">
      <h2 class="featured-title">Discover Categories</h2>
      <div class="grid">
        <% categories.forEach(cat => { %>
          <div class="card">
            <img src="<%= cat.image %>" alt="<%= cat.name %>" />
            <p class="art-title"><%= cat.name %></p>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <div class="container">
      <p>&copy; 2025 ArtHub. All rights reserved.</p>
    </div>
  </footer>

</body>
</html>
