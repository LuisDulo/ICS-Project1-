<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Canvas Editor</title>
  <link rel="stylesheet" href="/canvas.css">
</head>
<body>
  <header class="navbar">
    <div class="logo">🎨 ArtHub</div>
    <nav>
      <a href="/home">Home</a>
      <a href="/canvas" class="active">Canvas Editor</a>
      <a href="/marketplace">Marketplace</a>
      <a href="/designers">Hire a Designer</a>
      <a href="#">User Profiles</a>
    </nav>
    <input type="search" placeholder="Search ArtHub...">
  </header>

  <div class="editor">
    <aside class="sidebar">
      <h3>Editor Tools</h3>

      <section>
        <strong>Drawing Tools</strong>
        <button onclick="setTool('brush')">🖌️ Brush</button>
        <button onclick="setTool('eraser')">🧽 Eraser</button>
      </section>

      <section>
        <strong>Shapes</strong>
        <button onclick="addShape('rect')">▭ Rectangle</button>
        <button onclick="addShape('circle')">⚪ Circle</button>
      </section>

      <section>
        <strong>Text</strong>
        <button onclick="addText()">Add Text</button>
      </section>

      <section>
        <strong>Assets</strong>
        <input type="file" id="upload" accept="image/*">
      </section>

      <section>
        <strong>Actions</strong>
        <button onclick="undo()">↶ Undo</button>
        <button onclick="redo()">↷ Redo</button>
        <button onclick="exportImage()">📷 Export</button>
      </section>

      <section>
        <strong>Pen Settings</strong>
        <label for="penColor">Pen Color</label>
        <input type="color" id="penColor" value="#000000">

        <label for="penOpacity">Opacity</label>
        <input type="range" id="penOpacity" min="0" max="1" step="0.1" value="1">
      </section>
    </aside>

    <main>
      <canvas id="canvas" width="1000" height="600"></canvas>
    </main>
  </div>

  <script src="/canvas.js"></script>
</body>
</html>
